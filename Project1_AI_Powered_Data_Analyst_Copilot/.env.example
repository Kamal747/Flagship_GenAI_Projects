# Copy this file to `.env` and fill in your real values. Never commit `.env`.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Automatic model fallback: if GROQ_MODEL (or the first model below) hits a
# 429 rate limit, the app automatically switches to the next model in this
# list, in order. Comma-separated, no spaces needed. Leave unset to use the
# built-in default chain (gpt-oss-120b -> gpt-oss-20b -> qwen3-32b -> llama-3.3-70b).
# GROQ_MODEL_FALLBACK_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.3-70b-versatile

MAX_UPLOAD_MB=200
SANDBOX_TIMEOUT_SECONDS=5
MAX_ROWS_PREVIEW=50
LARGE_DATASET_ROW_THRESHOLD=200000
LLM_TEMPERATURE=0.2
