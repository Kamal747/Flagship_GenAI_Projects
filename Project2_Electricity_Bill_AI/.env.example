# Copy this file to `.env` and fill in your real values. Never commit `.env`.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional automatic model fallback chain (comma-separated). If GROQ_MODEL
# hits a capacity/quota limit, the app automatically switches to the next
# model in this list. Leave unset to use the built-in default chain.
# GROQ_MODEL_FALLBACK_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.3-70b-versatile

LLM_TEMPERATURE=0.2
